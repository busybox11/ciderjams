{
  "name": "@ciderjams/plugin",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./api/*": "./src/api/*",
    "./cider/*": "./src/cider/*",
    "./entry/*": "./src/entry/*",
    "./musickit/*": "./src/musickit/*",
    "./playback/*": "./src/playback/*",
    "./shareplay/*": "./src/shareplay/*",
    "./session/*": "./src/session/*",
    "./ui/*": "./src/ui/*"
  },
  "plugin": {
    "ce_prefix": "ciderjams",
    "identifier": "net.busybox11.ciderjams"
  },
  "scripts": {
    "dev": "vite",
    "dev:vue-devtools": "VITE_WITH_VUE_DEVTOOLS=true vite",
    "dev:cider": "hyprctl dispatch exec /usr/lib/cider/Cider -- --remote-debugging-port=8315",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepare-marketplace": "tsx ./scripts/market-pack.cts",
    "update-pluginkit": "pnpm up @ciderapp/pluginkit"
  },
  "dependencies": {
    "@ciderjams/proto": "workspace:*",
    "@elysia/eden": "^1.4.10",
    "@paralleldrive/cuid2": "^2.2.2",
    "lodash": "^4.17.21",
    "lucide-vue": "^0.517.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@ciderapp/pluginkit": "github:ciderapp/pluginkit",
    "@ciderjams/server": "workspace:^",
    "@types/lodash": "^4.17.6",
    "@types/musickit": "ciderapp/musickit-types",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/devtools": "^8.0.2",
    "adm-zip": "0.5.9",
    "pinia": "^2.2.0",
    "sass": "^1.77.6",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^0.17.6",
    "vite": "^6.0.7",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vite-tsconfig-paths": "^4.3.2",
    "vue-tsc": "^3.1.0",
    "yaml": "^2.4.5"
  }
}
